{
  "expo": {
    "name": "Gider Defteri",
    "slug": "gider-defteri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "giderdefteri",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0E13",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.giderdefteri.app"
    },
    "android": {
      "package": "com.giderdefteri.app",
      "adaptiveIcon": {
        "backgroundColor": "#102C27",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0A0E13"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fişlerinizin fotoğraflarını seçebilmek için galeri erişimi gerekiyor.",
          "cameraPermission": "Fişlerinizin fotoğrafını çekebilmek için kamera erişimi gerekiyor."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5574d04a-9b05-426d-900a-eaf625db0cf8"
      }
    }
  }
}
